# ---------- BUILD STAGE ----------
FROM golang:1.26.0-alpine3.22 AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/cmd/seeder ./cmd/seeder
COPY backend/configs ./configs
COPY backend/internal/constants ./internal/constants
COPY backend/internal/infra/database ./internal/infra/database
COPY backend/internal/infra/logger ./internal/infra/logger
COPY backend/internal/utils ./internal/utils
COPY backend/seeds ./seeds

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o bin/seeder cmd/seeder/main.go

# ---------- RUNTIME STAGE ----------
FROM alpine:3.22

WORKDIR /root

COPY --from=builder /app/bin ./bin
COPY --from=builder /app/configs ./configs
COPY --from=builder /app/seeds ./seeds

ENTRYPOINT ["./bin/seeder"]
