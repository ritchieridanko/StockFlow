# ---------- Backend ----------
SERVER_HOST="stockflow-backend"
SERVER_PORT=8080
SERVER_TIMEOUT_READ="5s"
SERVER_TIMEOUT_WRITE="5s"
SERVER_TIMEOUT_SHUTDOWN="10s"

# ---------- Frontend ----------
CLIENT_HOST="localhost"
CLIENT_PORT=5173

# ---------- Database ----------
DATABASE_HOST="stockflow-database"
DATABASE_PORT=5432
DATABASE_USER="postgres"
DATABASE_PASS="password"
DATABASE_NAME="stockflow_db"
DATABASE_SSL_MODE="disable"
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONN_LIFETIME="1h"
DATABASE_MAX_CONN_IDLE_TIME="30m"

# ---------- Jaeger Tracer ----------
TRACER_HOST="jaeger"
TRACER_PORT=4318
TRACER_WEB_UI_PORT=16686
